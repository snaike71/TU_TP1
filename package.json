{
  "name": "@snaike7/tp-ynov",
  "version": "2.0.1",
  "description": "",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-npm-ci": "rm -rf dist && mkdir dist && NODE_ENV=production npx babel src --out-dir dist --copy-files --no-copy-ignored --ignore \"**/*.test.js\",\"**/*.test.jsx\",\"**/*.spec.js\",\"**/*.spec.jsx\",\"**/__tests__/**\",\"**/jest.setup.js\"",
    "build-npm": "SET NODE_ENV=production && if exist dist rmdir /s /q dist && mkdir dist && npx babel src --out-dir dist --copy-files --no-copy-ignored --ignore \"**/*.test.js\",\"**/*.test.jsx\",\"**/*.spec.js\",\"**/*.spec.jsx\",\"**/__tests__/**\",\"**/jest.setup.js\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "jsdoc": "jsdoc -c ./jsdoc.config.json -r -d ./docs",
    "prepublishOnly": "npm run build-npm-ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snaike71/TU_TP1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/snaike71/TU_TP1/issues"
  },
  "homepage": "https://github.com/snaike71/TU_TP1#readme",
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-jest": "^30.2.0",
    "cypress": "^15.10.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdoc": "^4.0.5",
    "react-test-renderer": "^19.2.4",
    "vite": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./src/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/cypress/"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "identity-obj-proxy"
    }
  },
  "dependencies": {
    "axios": "^1.13.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "react-toastify": "^11.0.5"
  }
}
